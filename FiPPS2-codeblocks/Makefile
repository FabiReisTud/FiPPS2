$(OBJS_mkd2):
	@mkdir -p $(OBJS_DIR)
	$(FC) $(CFLAGS) -c $(SRC_DIR_mkd2)$(@:.o=.mk) -o $(OBJS_DIR)$@

$(OBJS_d9):
	@mkdir -p $(OBJS_DIR)
	$(FC) $(CFLAGS) -c $(SRC_DIR_d9)$(@:.o=.) -o $(OBJS_DIR)$@

$(OBJS_f90d9):
	@mkdir -p $(OBJS_DIR)
	$(FC) $(CFLAGS) -c $(SRC_DIR_f90d9)$(@:.o=.f90) -o $(OBJS_DIR)$@

$(OBJS_d10):
	@mkdir -p $(OBJS_DIR)
	$(FC) $(CFLAGS) -c $(SRC_DIR_d10)$(@:.o=.) -o $(OBJS_DIR)$@

$(OBJS_f90d10):
	@mkdir -p $(OBJS_DIR)
	$(FC) $(CFLAGS) -c $(SRC_DIR_f90d10)$(@:.o=.f90) -o $(OBJS_DIR)$@

$(OBJS_f90d11):
	@mkdir -p $(OBJS_DIR)
	$(FC) $(CFLAGS) -c $(SRC_DIR_f90d11)$(@:.o=.f90) -o $(OBJS_DIR)$@

clean :
	rm -f $(OBJS_DIR)*.*
	rm -f $(EXE_DIR)$(EXE)

